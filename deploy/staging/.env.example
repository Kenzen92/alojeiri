# Copy to /opt/alojeiri/.env on the VPS (never commit the real file).
STAGING_DOMAIN=staging.example.com

DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets
DJANGO_ALLOWED_HOSTS=staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=alojeiri
POSTGRES_USER=alojeiri
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://alojeiri:change-me@db:5432/alojeiri
