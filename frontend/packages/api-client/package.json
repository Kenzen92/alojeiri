{
  "name": "@alojeiri/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the Django REST API (types generated from the OpenAPI schema)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen": "openapi-typescript ${OPENAPI_SCHEMA_URL:-http://localhost:8000/api/schema/} -o src/generated/schema.d.ts"
  },
  "devDependencies": {
    "@alojeiri/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "openapi-typescript": "7.13.0"
  }
}
