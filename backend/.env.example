# Copy to .env to override. Compose loads this file by default, so `make up` works out of the box.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-key-not-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Inside compose the host is `db`; from the host machine use localhost:5432.
POSTGRES_DB=alojeiri
POSTGRES_USER=alojeiri
POSTGRES_PASSWORD=alojeiri
DATABASE_URL=postgres://alojeiri:alojeiri@db:5432/alojeiri
